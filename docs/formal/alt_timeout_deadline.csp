-- assertion checked alone with -csp_assertion; states = ProB coverage STATES)
--  #  assertion                                            expected  ProB  states  s    note
--  1  SPEC(<2>) [FD= SYS(M2, <2>, 0, STALE, 0) \ diff(Even FAIL      FAIL    2325    2.8  
--  2  STOP [T= SYS(M2, <2>, 0, STALE, 12) \ diff(Events, { FAIL      FAIL   17852   29.6  
--  3  SPEC(<2>) [FD= SYS(M3, <2>, 0, NOST, 0) \ diff(Event FAIL      FAIL     570    0.9  
--  4  SPEC(<2>) [FD= SYS(M2, <2>, 0, NOST, 0) \ diff(Event PASS      PASS     405    0.5  
--  5  SPEC(<2>) [FD= SYS(OK, <2>, 0, STALE, 0) \ diff(Even PASS      PASS    1637    2.8  
--  6  SPEC(<GC, 2>) [FD= SYS(OK, <GC, 2>, 0, STALE, 0) \ d PASS      PASS    2133    3.4  
--  7  SPEC(<GC, 2>) [FD= SYS(OK, <GC, 2>, 1, STALE, 0) \ d PASS      PASS    6908   12.1  
--  8  SPEC(<3, 1>) [FD= SYS(OK, <3, 1>, 0, STALE, 0) \ dif PASS      PASS    1157    1.7  
--  9  SPEC(<0>) [FD= SYS(OK, <0>, 0, STALE, 0) \ diff(Even PASS      PASS     333    0.5  
-- 10  SPEC(<GC, 0>) [FD= SYS(OK, <GC, 0>, 1, STALE, 0) \ d PASS      PASS    1540    3.0  
-- 11  SYS(OK, <GC, 2>, 1, STALE, 0) :[deadlock free [F]]   PASS      PASS    6890   10.7  
-- 12  SYS(OK, <GC, 2>, 1, STALE, 0) \ diff(Events, OBS) :[ PASS      PASS    6890   11.7  
-- 13  STOP [T= SYS(OK, <3, 1>, 0, STALE, 0) \ diff(Events, PASS      PASS    1140    2.0  
-- 14  STOP [T= SYS(OK, <0>, 0, STALE, 0) \ diff(Events, {| PASS      PASS     324    0.9  
-- 15  STOP [T= SYS(OK, <GC, 0>, 1, STALE, 0) \ diff(Events PASS      PASS    1523    3.4  
-- 16  (p_off -> a_sel.GC?_?_ -> STOP) [T= (SYS(OK, <GC, 0> PASS      PASS     230    0.5  
-- 17  STOP [T= SYS(OK, <GC, 2>, 1, STALE, 0) \ diff(Events PASS      PASS    6891    9.9  
-- 18  STOP [T= SYS(OK, <3, 1>, 0, STALE, 0) \ diff(Events, PASS      PASS    1140    1.6  
-- 19  TW(false) [T= SYS(OK, <GC, 2>, 1, STALE, 0) \ diff(E PASS      PASS    6907   15.2  
-- 20  TW(true) [T= SYS(OK, <GC, 2>, 1, STALE, 0) \ diff(Ev FAIL      FAIL     399    0.4  a_block.1, tick, a_wake.false: the tie
-- =============================================================================
