<?xml version="1.0" encoding="utf-8"?>
<!-- CSP4CMSIS events for CMSIS-View Event Recorder (component 0x50).
     context: the thread (thread mode, kernel running), "irq" and the
     exception number (handler mode; recorded as 0x80000000 | IPSR) or
     "pre-kernel" (thread mode before the kernel runs; recorded as 0).
     Recorded only in builds with CSP4CMSIS_TRACE: see
     csp4cmsis/inc/csp/csp4cmsis_trace.h. Decode together with the RTOS's
     .scvd file, e.g. with tools/trace/decode.py. -->
<component_viewer schemaVersion="1.2.0" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="Component_Viewer.xsd">
  <component name="CSP4CMSIS" shortname="CSP" version="3.1.0"/>

  <events>
    <group name="CSP4CMSIS">
      <component name="CSP4CMSIS Events" brief="CSP" no="0x50" prefix="CSP4CMSIS_EVT_" info="CSP4CMSIS processes, channels and ALT"/>
    </group>

    <event id="0x5000 + 0x00" level="Op" property="ProcessStart" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], process=%S[val2]" info="A process started: its thread entered run()."/>
    <event id="0x5000 + 0x01" level="Op" property="ProcessEnd" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], process=%S[val2]" info="A process returned from run()."/>
    <event id="0x5000 + 0x02" level="Op" property="ProcessName" value="name=%t[val1]" info="Name of the process that just started (CSProcess::name())."/>
    <event id="0x5000 + 0x10" level="Op" property="RendezvousDone" value="writer=%x[val1], reader=%x[val2], channel=%S[val3], by_reader=%d[val4]" info="A rendezvous paired its writer and reader; recorded once, by the second to arrive (by_reader: 1 the reader, 0 the writer)."/>
    <event id="0x5000 + 0x20" level="Op" property="AltSelected" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], guard=%d[val2]" info="An Alternative selected the guard with this index in its guard list."/>
    <event id="0x5000 + 0x30" level="Op" property="BufferedPut" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2], count=%d[val3], capacity=%d[val4]" info="A thread stored an element in a buffered channel (count: elements after it)."/>
    <event id="0x5000 + 0x31" level="Op" property="BufferedGet" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2], count=%d[val3], capacity=%d[val4]" info="A thread took an element from a buffered channel (count: elements after it)."/>
    <event id="0x5000 + 0x32" level="Op" property="PutFromISR" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2], count=%d[val3], capacity=%d[val4]" info="Put executed in handler mode: an element was stored in a buffered channel."/>
    <event id="0x5000 + 0x33" level="Op" property="DroppedNew" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2], count=%d[val3], capacity=%d[val4]" info="A put to a full KeepOldest channel was rejected."/>
    <event id="0x5000 + 0x34" level="Op" property="OverwroteOldest" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2], count=%d[val3], capacity=%d[val4]" info="A put to a full KeepNewest channel replaced the oldest element (no BufferedPut is recorded for it)."/>
    <event id="0x5000 + 0x40" level="Error" property="SpawnFailed" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], process=%S[val2]" info="Run() could not create the thread of this process (osThreadNew() failed)."/>
    <event id="0x5000 + 0x60" level="Detail" property="WaitChannel" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2]" info="May block on a rendezvous channel: its end is busy, or waiting for the partner."/>
    <event id="0x5000 + 0x61" level="Detail" property="WaitBufferedFull" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2]" info="May block: a put to a full Block channel waits for space."/>
    <event id="0x5000 + 0x62" level="Detail" property="WaitBufferedEmpty" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], channel=%S[val2]" info="May block: a get waits for an element."/>
    <event id="0x5000 + 0x63" level="Detail" property="WaitAlt" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], alt=%S[val2]" info="May block: an Alternative waits for a guard (or its timeout)."/>
    <event id="0x5000 + 0x64" level="Detail" property="WaitBarrier" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], barrier=%S[val2]" info="May block: a process waits at a barrier."/>
    <event id="0x5000 + 0x65" level="Detail" property="WaitJoin" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], join=%x[val2]" info="May block: Run(TerminatingNetwork) waits for its processes (val2: the completion semaphore)."/>
    <event id="0x5000 + 0x6E" level="Detail" property="Resume" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], object=%S[val2]" info="The wait on this object returned."/>
    <event id="0x5000 + 0x6F" level="Detail" property="ResumeTimeout" value="context=%t[val1 == 0 ? &quot;pre-kernel&quot; : ((val1 &amp; 0x80000000) ? &quot;irq&quot; : &quot;thread&quot;)] %x[val1 &amp; 0x7FFFFFFF], object=%S[val2]" info="The ALT wait on this Alternative ended by its timeout."/>
  </events>
</component_viewer>
