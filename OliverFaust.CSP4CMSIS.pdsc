<?xml version="1.0" encoding="UTF-8"?>
<package schemaVersion="1.7.2" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>OliverFaust</vendor>

  <name>CSP4CMSIS</name>
  <description>CSP (Communicating Sequential Processes) channels, ALT/select and processes for CMSIS-RTOS2 (FreeRTOS, RTX5)</description>

  <url>https://github.com/OliverFaust/CSP4CMSIS/releases/latest/download/</url>
  <supportContact>https://github.com/OliverFaust/CSP4CMSIS/issues</supportContact>
  <license>LICENSE</license>

  <releases>
    <release version="2.1.0" date="2026-10-06">
      A failed osThreadNew() in Run() and a 17th ALT guard are fatal errors
      (csp4cmsis_fatal_error) instead of a silent hang or an ignored guard.
      Seconds()/Milliseconds() round up (64-bit, no overflow); SleepFor(Time).
      Deprecated (removed in 3.0): Run(CSProcess&amp;), CSP_DEFAULT_TASK_PRIORITY,
      CSP_LEGACY_PARALLEL_PRIORITY (now CSP_DEFAULT_NETWORK_PRIORITY),
      One2OneChannel, BufferedOne2OneChannel. Removed the never-called
      CSProcess::endProcess(). docs/CHANGES_2.1.0.md.
    </release>
    <release version="2.0.1" date="2026-10-03">
      ALT timeouts (RelTimeoutGuard) without an RTOS timer: the deadline is
      fixed when select() starts, so no timer service priority requirement,
      no RTOS memory, and no wakeup can postpone a timeout (fixes the 2.0.0
      crash/hang with FreeRTOS, see docs/known-issues.md). Builds without
      CMSIS packs (CSP4CMSIS_DEVICE_HEADER); only csp4cmsis/inc/ on the
      include path. Verified with ST's STM32Cube CMSIS-RTOS2 wrapper.
      API unchanged. docs/CHANGES_2.0.1.md.
    </release>
    <release version="2.0.0" date="2026-09-27">
      Rendezvous and signal channels use a one-winner ALT protocol with
      re-verified wakeups (no lost, phantom or silent communications;
      model-checked with ProB). BufferedChannel: static ring buffer with
      atomic KeepNewest, lost-wakeup and livelock fixes. ISR writes only via
      buffered channels (isrWriter(), IsrChanout, element-size limit);
      KeepNewest/KeepOldest only on buffered channels. Reusable Barrier.
      No dynamic allocation in the library; with CSP4CMSIS_STATIC_ALLOCATION
      no dynamic RTOS allocation. Breaking changes and migration guide:
      docs/CHANGES_2.0.md.
    </release>
    <release version="1.0.0" date="2026-09-24">
      Initial pack release. csp4cmsis migrated from FreeRTOS-native to
      CMSIS-RTOS2; verified on the CMSIS-RTOS2-over-FreeRTOS adapter and
      native RTX5 (DK-E8, Cortex-M55). Backend-agnostic static allocation,
      portable BASEPRI-based critical sections, ARM AAPCS-correct stack
      alignment. Also includes the fixes that make the pack itself
      actually installable: the .pdsc filename corrected to the required
      &lt;Vendor&gt;.&lt;PackName&gt;.pdsc convention, and a missing
      csp4cmsis/inc/ include-path declaration added (consumers reach the
      public API via #include "csp/csp4cmsis.h", which needs that
      directory on the path) -- both found by actually installing this
      pack and building a project against it as a component, not by
      schema validation alone.
    </release>
  </releases>

  <keywords>
    <keyword>CSP</keyword>
    <keyword>Communicating Sequential Processes</keyword>
    <keyword>Concurrency</keyword>
    <keyword>CMSIS-RTOS2</keyword>
    <keyword>Channels</keyword>
  </keywords>

  <conditions>
    <!-- Generic CMSIS-RTOS2 API condition — deliberately not tied to
         FreeRTOS or RTX5 specifically. This is the real structural payoff
         of the migration: one component, one condition, works against
         either backend, because csp4cmsis only ever calls the standard
         cmsis_os2.h surface. The backend-specific seam
         (csp_rtos_static.h's static-allocation types) is handled inside
         the source via the CSP4CMSIS_RTOS2_BACKEND_* defines, not via
         separate pack components/conditions. -->
    <condition id="CSP4CMSIS Core">
      <description>Requires a CMSIS-RTOS2 API implementation and CMSIS-Core.</description>
      <require Cclass="CMSIS" Cgroup="RTOS2"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
  </conditions>

  <components>
    <component Cclass="CSP4CMSIS" Cgroup="Core" Cversion="2.1.0" condition="CSP4CMSIS Core">
      <description>CSP4CMSIS core: channels, ALT/select, processes (see Documentation/CSP4CMSIS_Configuration.md)</description>
      <files>
        <!-- Include path: csp4cmsis/inc/ only. Applications include
             "csp/csp4cmsis.h"; the library's headers include each other
             from their own directory. The headers are listed as
             category="other": category="header" would make the build add
             each header's directory (csp4cmsis/inc/csp/) to the include
             path (before 3.0, csp/time.h there hid the C library's <time.h>). -->
        <file category="include" name="csp4cmsis/inc/"/>

        <!-- Headers (not include paths, see above) -->
        <file category="other" name="csp4cmsis/inc/csp/alt.h"/>
        <file category="other" name="csp4cmsis/inc/csp/alt_channel_sync.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp_semaphore.h"/>
        <file category="other" name="csp4cmsis/inc/csp/barrier.h"/>
        <file category="other" name="csp4cmsis/inc/csp/buffered_channel.h"/>
        <file category="other" name="csp4cmsis/inc/csp/channel_base.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp_critical.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp_fatal.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp_rtos_static.h"/>
        <file category="other" name="csp4cmsis/inc/csp/process.h"/>
        <file category="other" name="csp4cmsis/inc/csp/public_channel.h"/>
        <file category="other" name="csp4cmsis/inc/csp/public_task.h"/>
        <file category="other" name="csp4cmsis/inc/csp/rendezvous_channel.h"/>
        <file category="other" name="csp4cmsis/inc/csp/run.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp_time.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp_version.h"/>
        <file category="other" name="csp4cmsis/inc/csp/csp4cmsis.h"/>

        <!-- Sources -->
        <file category="source" name="csp4cmsis/src/alt_channel_sync.cpp"/>
        <file category="source" name="csp4cmsis/src/alternative.cpp"/>
        <file category="source" name="csp4cmsis/src/barrier.cpp"/>
        <!-- buffered_channel.cpp is intentionally empty (its own comment:
             "left empty to resolve linker conflicts" — BufferedChannel<T,P>
             is a template, all its logic lives in buffered_channel.h).
             Still listed: it is a translation unit every consuming
             project compiles. -->
        <file category="source" name="csp4cmsis/src/buffered_channel.cpp"/>
        <file category="source" name="csp4cmsis/src/channel_sync.cpp"/>
        <file category="source" name="csp4cmsis/src/csp_wrapper.cpp"/>
        <file category="source" name="csp4cmsis/src/glue.cpp"/>

        <!-- Documentation -->
        <file category="doc" name="Documentation/CSP4CMSIS_Configuration.md"/>
        <file category="doc" name="docs/CHANGES_2.0.md"/>
        <file category="doc" name="docs/CHANGES_2.0.1.md"/>
        <file category="doc" name="docs/CHANGES_2.1.0.md"/>
        <file category="doc" name="Documentation/CSP4CMSIS_STM32CubeIDE.md"/>
      </files>
    </component>
  </components>
</package>
